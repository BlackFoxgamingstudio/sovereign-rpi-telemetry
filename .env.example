# ==============================================================================
# Sovereign Biz Box: Solution 01 (sovereign-rpi-telemetry)
# Environment Configuration Matrix
# ==============================================================================

# Network & Daemon Configuration
SBB_RPI_PORT=8770
SBB_RPI_HOST=0.0.0.0
SBB_NODE_ID=sbb-edge-node-01
SBB_ENVIRONMENT=development
SBB_LOG_LEVEL=INFO

# Polling & Telemetry Frequency
SBB_TELEMETRY_POLL_INTERVAL_SECONDS=30
SBB_SYSFS_THERMAL_PATH=/sys/class/thermal/thermal_zone0/temp

# Hardware Alert Thresholds
SBB_IOT_TEMP_WARNING_C=72.0
SBB_IOT_TEMP_CRITICAL_C=82.0
SBB_IOT_RAM_WARNING_PCT=80.0
SBB_IOT_RAM_CRITICAL_PCT=92.0
SBB_IOT_DISK_CRITICAL_PCT=95.0

# Upstream Integration Endpoints
SBB_N8N_BASE_URL=http://127.0.0.1:5678
SBB_VAULT_BRIDGE_URL=http://127.0.0.1:8766
SBB_AVATAR_SERVICE_URL=http://127.0.0.1:8785

# Autonomous Self-Healing Handshake
SBB_ESCALATE_TO_SRE=true
SBB_SRE_WEBHOOK_URL=http://127.0.0.1:5678/webhook/avatar-agents
